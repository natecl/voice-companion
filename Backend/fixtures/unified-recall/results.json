  {
    "case": "omitted",
    "question": "What explains ice cream sales and swimming?",
    "events": [
      {
        "type": "accepted",
        "question_id": "omitted",
        "conversation_id": "5b178c7a-34f3-4249-bf9c-3f63f2e6b717"
      },
      {
        "type": "context",
        "sources": [
          {
            "session_id": "notes-lecture",
            "revision": 1,
            "passage_id": "p2",
            "captured_at": 1790461403.0,
            "timezone": "America/New_York",
            "origin": "recording",
            "start": 8.0,
            "speakers": [
              1
            ],
            "text_start": 0,
            "text_end": 124,
            "text": "A common cause can explain an observed association. For example, hot weather can increase both ice cream sales and swimming.",
            "lifecycle": [],
            "evidence_type": "original_source",
            "claim_scope": "whole_passage",
            "id": "p1"
          },
          {
            "session_id": "notes-lecture",
            "revision": 1,
            "passage_id": "p1",
            "captured_at": 1790461403.0,
            "timezone": "America/New_York",
            "origin": "recording",
            "start": 0.0,
            "speakers": [
              0
            ],
            "text_start": 0,
            "text_end": 99,
            "text": "Today we distinguish correlation from causation. Correlation describes variables changing together.",
            "lifecycle": [],
            "evidence_type": "original_source",
            "claim_scope": "whole_passage",
            "id": "p2"
          },
          {
            "session_id": "notes-lecture",
            "revision": 1,
            "passage_id": "p3",
            "captured_at": 1790461403.0,
            "timezone": "America/New_York",
            "origin": "recording",
            "start": 16.0,
            "speakers": [
              0
            ],
            "text_start": 0,
            "text_end": 94,
            "text": "Random assignment can help estimate causal effects, but this lecture does not assign homework.",
            "lifecycle": [],
            "evidence_type": "original_source",
            "claim_scope": "whole_passage",
            "id": "p3"
          }
        ],
        "memory_status": "available"
      },
      {
        "type": "delta",
        "text": "Hot weather is a common cause: it can increase both ice cream sales and swimming, creating an association between them without one causing the other. [[p1]]"
      },
      {
        "type": "done",
        "question_id": "omitted",
        "references": [
          "p1"
        ],
        "saved": true
      }
    ]
  },
