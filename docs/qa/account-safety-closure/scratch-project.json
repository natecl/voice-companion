{
  "name": "AccountSafetyClosure",
  "options": {
    "bundleIdPrefix": "ai.voicecompanion",
    "deploymentTarget": {
      "macOS": "15.0"
    }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "6.0",
      "GENERATE_INFOPLIST_FILE": "YES",
      "CODE_SIGNING_ALLOWED": "NO"
    }
  },
  "targets": {
    "CoreTests": {
      "type": "bundle.unit-test",
      "platform": "macOS",
      "sources": [
        {
          "path": "/private/tmp/voice-companion-account-safety-closure-20261001/UnitTests"
        },
        {
          "path": "/private/tmp/voice-companion-account-safety-closure-20261001/App/Transcription"
        },
        {
          "path": "/private/tmp/voice-companion-account-safety-closure-20261001/App/Sessions"
        },
        {
          "path": "/private/tmp/voice-companion-account-safety-closure-20261001/App/Audio"
        }
      ]
    }
  },
  "schemes": {
    "AccountSafetyClosure": {
      "build": {
        "targets": {
          "CoreTests": "all"
        }
      },
      "test": {
        "targets": [
          "CoreTests"
        ]
      }
    }
  }
}
